[Unit]
Description=CEC over HTTP Daemon
After=network.target

[Service]
Type=simple
# Change 'pi' to your system user if necessary
User=pi
# Adjust the path to where you cloned the repository
WorkingDirectory=/home/pi/CEC-over-HTTP
ExecStart=/usr/bin/python3 /home/pi/CEC-over-HTTP/cec_daemon.py --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
